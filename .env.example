# Opcional: si el repo de infraestructura tiene su .env en la carpeta de arriba, Service A lo lee
# de ahí y este archivo no hace falta. Úsalo solo para correr Service A por separado.
# Copia este archivo como .env (el .env no se sube al repo).

# PostgreSQL de Supabase (pídela al equipo; no la subas al repo)
DATABASE_URL=postgresql://postgres.[SUPABASE-PROJECT].supabase.co:6543/postgres

# Debe ser idéntico al HMAC_SECRET de Service B
HMAC_SECRET=mi-secreto-compartido

# Dónde está Service B. Sin Docker: http://localhost:3001 (en Docker lo define docker-compose)
SERVICE_B_URL=http://localhost:3001

# Puerto en el que escucha Service A
PORT=3000

# ONVO (pagos reales de prueba). Claves del Dashboard de ONVO, modo prueba (onvo_test_...).
# La secreta nunca sale de Service A; la publicable sí se envía al navegador (la usa el SDK).
ONVO_SECRET_KEY=
ONVO_PUBLISHABLE_KEY=
# Aparece junto al webhook en el Dashboard cuando se registra la URL pública (paso 4).
ONVO_WEBHOOK_SECRET=
